---
import Base from '../layouts/Base.astro';
import TopPicks from '../components/islands/TopPicks';

const cards = [
  { href: '/tier-list', title: 'Tier List', body: 'Every champion ranked by role, rank, and region — scannable at a glance.' },
  { href: '/bot-lane', title: 'Bot Lane', body: 'ADC matchups, ADC + Support synergy, and a counter-pick recommender.' },
  { href: '/champions', title: 'Champions', body: 'Per-champion stats, best and toughest matchups, and builds.' },
  { href: '/methodology', title: 'Methodology', body: 'Exactly how the data is sampled, scored, and tiered. No black boxes.' },
];
---

<Base>
  <section class="flex flex-col gap-4 py-10 sm:py-16">
    <p class="text-sm font-semibold tracking-widest text-accent uppercase">lolperform.com</p>
    <h1 class="max-w-3xl text-4xl text-balance sm:text-5xl">
      The League tier list that respects your time — and goes deep on bot lane.
    </h1>
    <p class="max-w-2xl text-lg text-text-secondary">
      Readable rankings, ADC matchup depth, and honest numbers. Every stat shows its sample size,
      refreshed every patch.
    </p>
    <div class="flex flex-wrap gap-3 pt-2">
      <a
        href="/tier-list"
        class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-fg hover:bg-accent-hover"
      >
        Open the tier list
      </a>
      <a
        href="/bot-lane"
        class="rounded-md border border-border-default px-4 py-2 text-sm font-semibold text-text-primary hover:bg-bg-elevated"
      >
        Bot-lane tools
      </a>
    </div>
  </section>

  <section class="space-y-3">
    <div class="flex items-baseline justify-between">
      <h2>Top bot-lane picks</h2>
      <a href="/tier-list?role=BOTTOM" class="text-sm">Full list →</a>
    </div>
    <TopPicks client:load />
  </section>

  <section class="grid gap-3 py-12 sm:grid-cols-2">
    {
      cards.map((c) => (
        <a
          href={c.href}
          class="group rounded-lg border border-border-subtle bg-bg-surface p-5 transition-colors duration-150 hover:bg-bg-elevated"
        >
          <h3 class="flex items-center justify-between">
            {c.title}
            <span class="text-accent transition-transform duration-150 group-hover:translate-x-0.5">→</span>
          </h3>
          <p class="mt-1 text-sm text-text-muted">{c.body}</p>
        </a>
      ))
    }
  </section>
</Base>
