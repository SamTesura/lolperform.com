---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — lolperform" noindex>
  <section class="flex min-h-[50vh] flex-col items-center justify-center gap-3 text-center">
    <p class="font-display text-5xl font-bold text-accent">404</p>
    <h1>That page wandered off.</h1>
    <p class="text-text-muted">The champion, matchup, or page you're after isn't here.</p>
    <a href="/" class="mt-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-fg hover:bg-accent-hover">
      Back to the tier list
    </a>
  </section>
</Base>
