{
  "name": "lolperform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot-lane-first League of Legends tier list and matchup wiki.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lolperform/web dev",
    "build": "pnpm --filter @lolperform/web build",
    "preview": "pnpm --filter @lolperform/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cf:dev": "wrangler dev",
    "deploy": "pnpm --filter @lolperform/web build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "ws": ">=8.21.0",
      "undici": ">=7.28.0 <8",
      "yaml": ">=2.8.3"
    }
  }
}
