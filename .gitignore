# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.astro/
.output/
.vercel/
.wrangler/

# generated D1 load SQL (regenerated by the pipeline)
db/.generated/

# env & secrets — NEVER commit
.dev.vars
.dev.vars.*
*.local
.env
.env.*
!.env.example
*.secret
secrets/
# NOTE: riot.txt is Riot's PUBLIC domain-verification token (served at /riot.txt
# from apps/web/public/) — do NOT add it here. The API key only ever lives in
# .dev.vars / GitHub secrets.

# test / coverage
coverage/
*.lcov

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# data snapshots are generated; keep only committed seed under pipeline/data
pipeline/.cache/
# accumulated match store — runtime state, synced to R2, never committed
pipeline/data/store/

# claude code local machine settings
.claude/settings.local.json
